import torch
import torch.nn as nn

class Generator(nn.Module):
    def __init__(self, latent_dim, output_dim, condition_dim=0):
        super(Generator, self).__init__()
        self.latent_dim = latent_dim
        self.condition_dim = condition_dim
        
        # Input dimensions include noise vector and conditional input if provided
        input_dim = latent_dim + condition_dim
        
        # Progressive growing architecture
        self.model = nn.Sequential(
            # Initial block
            nn.Linear(input_dim, 256),
            nn.LeakyReLU(0.2),
            nn.BatchNorm1d(256),
            
            # Expansion blocks
            nn.Linear(256, 512),
            nn.LeakyReLU(0.2),
            nn.BatchNorm1d(512),
            
            nn.Linear(512, 1024),
            nn.LeakyReLU(0.2),
            nn.BatchNorm1d(1024),
            
            # Output layer - no activation to allow for physics constraints
            nn.Linear(1024, output_dim)
        )
        
        # Physics-informed constraint layer
        self.constraints = PhysicsConstraints()
        
    def forward(self, z, condition=None):
        # Concatenate noise and condition if provided
        if condition is not None and self.condition_dim > 0:
            z = torch.cat([z, condition], dim=1)
            
        # Generate raw output
        output = self.model(z)
        
        # Apply physics constraints
        constrained_output = self.constraints(output)
        
        return constrained_output

class Discriminator(nn.Module):
    def __init__(self, input_dim, condition_dim=0):
        super(Discriminator, self).__init__()
        self.condition_dim = condition_dim
        
        # Total input dimension including conditional input
        total_dim = input_dim + condition_dim
        
        # Wasserstein GAN architecture
        self.model = nn.Sequential(
            nn.Linear(total_dim, 1024),
            nn.LeakyReLU(0.2),
            nn.Dropout(0.3),
            
            nn.Linear(1024, 512),
            nn.LeakyReLU(0.2),
            nn.Dropout(0.3),
            
            nn.Linear(512, 256),
            nn.LeakyReLU(0.2),
            nn.Dropout(0.3),
            
            # Output layer without sigmoid for WGAN
            nn.Linear(256, 1)
        )
        
    def forward(self, x, condition=None):
        # Concatenate input and condition if provided
        if condition is not None and self.condition_dim > 0:
            x = torch.cat([x, condition], dim=1)
            
        return self.model(x)

class PhysicsConstraints(nn.Module):
    """Custom layer to enforce physics constraints on generated data"""
    def __init__(self):
        super(PhysicsConstraints, self).__init__()
        
    def forward(self, x):
        # Apply domain-specific constraints
        # Example: ensure temperature values are positive
        temperature_idx = 0  # Assuming first column is temperature
        x[:, temperature_idx] = torch.abs(x[:, temperature_idx])
        
        # Example: ensure pressure values are within realistic range
        pressure_idx = 1  # Assuming second column is pressure
        x[:, pressure_idx] = torch.clamp(x[:, pressure_idx], min=0.0, max=100.0)
        
        # Example: ensure values follow specific relationship (e.g., conservation laws)
        # This is a simplified example - would be customized for specific manufacturing data
        
        return x
